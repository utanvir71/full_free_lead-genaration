LEADGEN_BIND_HOST=127.0.0.1
LEADGEN_DATABASE_PATH=data/leadgen.sqlite3
LEADGEN_OVERPASS_URL=https://overpass-api.de/api/interpreter
LEADGEN_USER_AGENT=ZeroMoneyRestaurantLeadGenerator/0.1 (local operator)
LEADGEN_CANDIDATE_LIMIT=30
LEADGEN_HTTP_CONNECT_TIMEOUT_SECONDS=5
LEADGEN_HTTP_READ_TIMEOUT_SECONDS=15
LEADGEN_CRAWL_DELAY_SECONDS=1
LEADGEN_MAX_RESPONSE_BYTES=2000000
LEADGEN_OLLAMA_ENDPOINT=http://127.0.0.1:11434
LEADGEN_OLLAMA_MODEL=gemma4:e2b-it-qat
LEADGEN_OLLAMA_CONTEXT=8192
LEADGEN_OLLAMA_TEMPERATURE=0.4
LEADGEN_OLLAMA_MAX_OUTPUT_TOKENS=220
LEADGEN_OLLAMA_TIMEOUT_SECONDS=45
LEADGEN_EXPORT_DIRECTORY=exports
